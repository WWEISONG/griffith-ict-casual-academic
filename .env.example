# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Supabase project (Dashboard -> Project Settings -> API) ---------------
# The anon key is safe to ship in the browser bundle: it grants nothing on its
# own, because every table is protected by row level security.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Server-side only ------------------------------------------------------
# Bypasses row level security. Used ONLY by scripts/bootstrap.ts on your own
# machine. Never expose this to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Super administrator (created by `npm run bootstrap`) ------------------
SUPER_ADMIN_EMAIL=w.song@griffith.edu.au
SUPER_ADMIN_NAME=Wei Song
SUPER_ADMIN_PASSWORD=set-a-strong-password-here

# --- Local mode ------------------------------------------------------------
# When VITE_SUPABASE_URL is absent the app runs against in-browser sample data
# so it can be developed offline. This is the password for that mode only.
VITE_LOCAL_ADMIN_PASSWORD=set-a-local-password-here
